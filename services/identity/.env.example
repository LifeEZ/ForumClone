# Identity service
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/identity_db
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/identity_test

# RS256 keypair (PEM). Leave blank locally to auto-generate an ephemeral pair.
# In docker-compose / production, set both so tokens survive restarts and other
# services can verify them. Keep JWT_PRIVATE_KEY_PEM secret to this service only.
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_KEY_ID=hiver-identity-key

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]
