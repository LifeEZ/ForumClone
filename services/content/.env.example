# Content service
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/content_db
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/content_test

# Identity service base URL — Content fetches the RS256 public key from here
# and relays karma deltas to its /internal/karma endpoint (ADR-0003).
IDENTITY_URL=http://localhost:8001
JWT_KEY_ID=hiver-identity-key

# Shared secret guarding Identity's /internal/karma endpoint (ADR-0003).
# Must match Identity's INTERNAL_TOKEN. When set, Content starts the outbox relay.
INTERNAL_TOKEN=hiver-internal-token-change-me

DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]
