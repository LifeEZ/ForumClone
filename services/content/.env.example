# Content service
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/content_db
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/content_test

# Identity service base URL — Content fetches the RS256 public key from here.
